{
  "name": "check-pr-conflicts-action",
  "version": "1.0.0",
  "description": "Check pull requests for merge conflicts",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc --declaration false --declarationMap false",
    "build:watch": "tsc --watch",
    "package": "ncc build lib/index.js -o dist --license licenses.txt",
    "build-and-package": "npm run clean && npm run build && npm run package && rimraf lib",
    "clean": "rimraf dist lib",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build-and-package"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "github",
    "actions",
    "pull-request",
    "conflicts",
    "typescript"
  ],
  "author": "VyOS",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  }
}
